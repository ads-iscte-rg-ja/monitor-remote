CENTRAL_URL=http://localhost:3333
HOST_API_KEY=replace-with-the-host-api-key
SQLITE_PATH=remote-monitor.db
# Waits between completed collection/delivery cycles, not fixed wall-clock ticks.
COLLECTION_INTERVAL=30s
STATS_POST_INTERVAL=30s
# Polls SQLite for new errors; SDK writes do not notify the agent.
ERROR_POST_INTERVAL=10s
# Accepted ranges: collection/stats 5s-1h; error polling 1s-30s.
DISK_PATH=/

# Delivered records only. Pending and quarantined records are never auto-deleted.
# 0 disables cleanup; the default retains delivered records for seven days.
SENT_RETENTION_DAYS=7
CLEANUP_INTERVAL=1h
CLEANUP_BATCH_SIZE=1000
